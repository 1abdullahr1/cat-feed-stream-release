<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="6dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/card_background">

    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Ambient blurred backdrop -->
        <ImageView
            android:id="@+id/ambientBackdropView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.22"
            android:contentDescription="@null" />

        <!-- Ambient scrim -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#3D0F1115" />

        <!-- Main Cat Image / GIF: true native aspect ratio, zero stretch -->
        <ImageView
            android:id="@+id/catImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name" />

        <!-- Loading spinner -->
        <ProgressBar
            android:id="@+id/loadingIndicator"
            style="?android:attr/progressBarStyle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary"
            android:visibility="visible" />

        <!-- Double-tap heart -->
        <ImageView
            android:id="@+id/doubleTapHeart"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_cat_paw"
            android:alpha="0"
            android:scaleX="0.2"
            android:scaleY="0.2"
            android:visibility="gone"
            android:contentDescription="@string/like_action" />

        <!-- Bottom gradient scrim -->
        <View
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_gradient_scrim" />

        <!-- Bottom info row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginEnd="80dp"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="28dp">

            <!-- Type badge (GIF / PHOTO) -->
            <TextView
                android:id="@+id/mediaTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_kid_badge_photo"
                android:text="@string/photo_badge"
                android:textColor="@color/onScrim"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:letterSpacing="0.04"
                tools:text="GIF" />

            <!-- Kid-friendly cat name -->
            <TextView
                android:id="@+id/catTagsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/onScrim"
                android:textSize="24sp"
                android:textStyle="bold"
                android:shadowColor="@color/scrim_shadow"
                android:shadowRadius="6"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Fluffy Kitten" />

            <!-- Playful sound-word subtitle -->
            <TextView
                android:id="@+id/catIdText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/onScrimSecondary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="@color/scrim_shadow"
                android:shadowRadius="5"
                tools:text="Meow!" />

        </LinearLayout>

        <!-- Right side floating action buttons (60dp touch targets) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="32dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Like / paw button -->
            <ImageButton
                android:id="@+id/btnLike"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_kid_paw_button"
                android:contentDescription="@string/like_action"
                android:src="@drawable/ic_cat_paw_outline"
                android:padding="14dp" />

            <!-- Download button -->
            <ImageButton
                android:id="@+id/btnDownload"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_kid_paw_button"
                android:contentDescription="Save kitty"
                android:src="@drawable/ic_cat_download"
                android:padding="14dp" />

            <!-- Share button -->
            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_kid_paw_button"
                android:contentDescription="@string/share_action"
                android:src="@drawable/ic_share_cat"
                android:padding="14dp" />

        </LinearLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
